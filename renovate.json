{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Small updates merge on their own once the required CI checks pass; a red update stays open.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Majors can change behaviour that tests miss, so tidy reviews them and a person merges them.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["tidy:review"]
    },
    {
      "description": "Peer ranges set the oldest supported OpenCode; raise them by hand.",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Tests and dist must use what the OpenCode host ships, so these move together and right away.",
      "matchPackageNames": ["@opencode/**", "@opentui/**", "solid-js"],
      "groupName": "OpenCode host modules",
      "minimumReleaseAge": null
    },
    {
      "description": "One pull request for workflow actions.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
