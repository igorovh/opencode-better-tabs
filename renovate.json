{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Merge every update on its own once the required CI checks pass; a red update stays open.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "major"],
      "automerge": true
    },
    {
      "description": "Peer ranges set the oldest supported OpenCode; raise them by hand.",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Tests and dist must use what the OpenCode host ships, so these move together.",
      "matchPackageNames": ["@opencode/**", "@opentui/**", "solid-js"],
      "groupName": "OpenCode host modules"
    }
  ]
}
