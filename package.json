      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.18",
    "typescript": "^5.9.0"
  }
