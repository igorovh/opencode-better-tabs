  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorovh/opencode-better-tabs.git"
  },
  "keywords": ["opencode", "opencode-plugin", "opencode-v2", "tui", "tabs", "vertical-tabs", "opentui", "solidjs"],
  "files": ["dist", "README.md", "LICENSE"],
