{
  "name": "opencode-better-tabs",
  "version": "0.5.1",
  "description": "Vertical session tabs for the OpenCode V2 TUI: grouped by git repository, with visible two-step shortcuts and activity counters",
  "type": "module",
  "license": "MIT",
  "author": "igorovh",
  "homepage": "https://github.com/igorovh/opencode-better-tabs#readme",
  "bugs": {
    "url": "https://github.com/igorovh/opencode-better-tabs/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorovh/opencode-better-tabs.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "tui",
    "tabs",
    "vertical-tabs",
    "opentui",
    "solidjs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "compile": "bun scripts/compile.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "preview": "bun --preload @opentui/solid/preload scripts/preview.ts",
    "record": "bun scripts/record.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opentui/core": "0.9.0",
    "@opentui/solid": "0.9.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.0.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.65.0",
    "solid-js": "1.9.19",
    "typescript": "^7.0.0"
  }
}
